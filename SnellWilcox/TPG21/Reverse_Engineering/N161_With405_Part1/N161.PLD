Name     N161 ;
PartNo   "ATV750B" ;
Date     28/01/2026 ;
Revision 01 ;
Designer Matt Millman ;
Company  - ;
Assembly None ;
Location  ;
Device   V750 ;

/* &=AND #=OR $=XOR */

PIN 1 = CLK;
PIN 2 = nH_TC;
PIN 3 = V_DIV_SEL2;
PIN 4 = V_DIV_SEL1;
PIN 5 = V_DIV_SEL0;
PIN 6 = GEN_LOC;
PIN 7 = ODD_FIELD;
PIN 8 = i8;
PIN 14 = COUNT1pin;
PIN 16 = V_TC;
PIN 17 = o17;
PIN 18 = o18;
PIN 19 = D1_VBLKG;
PIN 20 = nODD_FIELD;
PIN 21 = COUNT9pin;
PIN 22 = COUNT8pin;
PIN 23 = COUNT3pin;

PINNODE 25 = COUNT0;
PINNODE 35 = COUNT1;
PINNODE 34 = COUNT2;
PINNODE 44 = COUNT3;
PINNODE 26 = COUNT4;
PINNODE 27 = COUNT5;
PINNODE 39 = COUNT6;
PINNODE 29 = COUNT7;
PINNODE 43 = COUNT8;
PINNODE 42 = COUNT9;
PINNODE 31 = COUNT10;

PINNODE 37 = V_TCq0;
PINNODE 40 = D1_VBLKGq0;
PINNODE 41 = nODD_FIELDq0;
PINNODE 38 = D1_VBLKG_RESET;

FIELD V_DIV_SEL = [V_DIV_SEL2..0];
FIELD COUNT = [COUNT10..0];

!V_TC.d =   (V_DIV_SEL: 0) & !GEN_LOC & (COUNT: 'd'625)  # /* 625 */
            (V_DIV_SEL: 1) & !GEN_LOC & (COUNT: 'd'525)  # /* 525 */
            (V_DIV_SEL: 2) & !GEN_LOC & (COUNT: 'd'623)  # /* Eureka 1250 */
            (V_DIV_SEL: 3) & !GEN_LOC & (COUNT: 'd'405) #  /* 405 line */
            GEN_LOC & !ODD_FIELD & nODD_FIELDq0;
V_TC.oe = 'b'0;

/* D1_VBLKG assert
 * On 405 line D1_VBLKG is not used for D1 blanking, but only for gating the
 * CLAMP signal. The values chosen have only this purpose.
 */
!D1_VBLKG.d =
            (V_DIV_SEL: 0) & !GEN_LOC & (COUNT: 'd'620) # /* 625 */
            (V_DIV_SEL: 1) & !GEN_LOC & (COUNT: 'd'522) # /* 525 */
            (V_DIV_SEL: 3) & !GEN_LOC & (COUNT: 'd'402) # /* 405 */
            (V_DIV_SEL: 0) & !GEN_LOC & (COUNT: 'd'307) # /* 625 */
            (V_DIV_SEL: 1) & !GEN_LOC & (COUNT: 'd'260) # /* 525 */
            (V_DIV_SEL: 3) & !GEN_LOC & (COUNT: 'd'200) # /* 405 */
            (V_DIV_SEL: 0) &  GEN_LOC & (COUNT: 'd'621) # /* 625 */
            (V_DIV_SEL: 1) &  GEN_LOC & (COUNT: 'd'523) # /* 525 */
            (V_DIV_SEL: 3) &  GEN_LOC & (COUNT: 'd'403) # /* 405 */
            (V_DIV_SEL: 0) &  GEN_LOC & (COUNT: 'd'308) # /* 625 */
            (V_DIV_SEL: 1) &  GEN_LOC & (COUNT: 'd'261) # /* 525 */
            (V_DIV_SEL: 3) &  GEN_LOC & (COUNT: 'd'201);  /* 405 */
D1_VBLKG.oe = 'b'1;

/* D1_VBLKG de-assert */
D1_VBLKG_RESET.d =
            (V_DIV_SEL: 0) & !GEN_LOC & (COUNT: 'd'19)  # /* 625 */
            (V_DIV_SEL: 1) & !GEN_LOC & (COUNT: 'd'6)   # /* 525 */
            (V_DIV_SEL: 3) & !GEN_LOC & (COUNT: 'd'3)   # /* 405 */
            (V_DIV_SEL: 0) & !GEN_LOC & (COUNT: 'd'332) # /* 625 */
            (V_DIV_SEL: 1) & !GEN_LOC & (COUNT: 'd'269) # /* 525 */
            (V_DIV_SEL: 3) & !GEN_LOC & (COUNT: 'd'206) # /* 405 */
            (V_DIV_SEL: 0) &  GEN_LOC & (COUNT: 'd'20)  # /* 625 */
            (V_DIV_SEL: 1) &  GEN_LOC & (COUNT: 'd'7)   # /* 525 */
            (V_DIV_SEL: 3) &  GEN_LOC & (COUNT: 'd'4)   # /* 405 */
            (V_DIV_SEL: 0) &  GEN_LOC & (COUNT: 'd'333) # /* 625 */
            (V_DIV_SEL: 1) &  GEN_LOC & (COUNT: 'd'270) # /* 525 */
            (V_DIV_SEL: 3) &  GEN_LOC & (COUNT: 'd'207);  /* 405 */

!nODD_FIELD.d =  ODD_FIELD;
nODD_FIELD.oe = 'b'0;

COUNT0.d =     !COUNT0;
!COUNT1pin.d = (COUNT1 $ COUNT0);
COUNT2.d =     (COUNT2 $ (COUNT1 & COUNT0));
!COUNT3pin.d = (COUNT3 $ (COUNT2 & COUNT1 & COUNT0));
COUNT4.d =     (COUNT4 $ (COUNT3 & COUNT2 & COUNT1 & COUNT0));
COUNT5.d =     (COUNT5 $ (COUNT4 & COUNT3 & COUNT2 & COUNT1 & COUNT0));
COUNT6.d =     (COUNT6 $ (COUNT5 & COUNT4 & COUNT3 & COUNT2 & COUNT1 & COUNT0));
COUNT7.d =     (COUNT7 $ (COUNT6 & COUNT5 & COUNT4 & COUNT3 & COUNT2 & COUNT1 & COUNT0));
COUNT8pin.d =  (COUNT8 $ (COUNT7 & COUNT6 & COUNT5 & COUNT4 & COUNT3 & COUNT2 & COUNT1 & COUNT0));
COUNT9pin.d =  (COUNT9 $ (COUNT8 & COUNT7 & COUNT6 & COUNT5 & COUNT4 & COUNT3 & COUNT2 & COUNT1 & COUNT0));
COUNT10.d =    !COUNT10;

COUNT1pin.oe = 'b'0;
COUNT3pin.oe = 'b'0;
COUNT8pin.oe = 'b'1;
COUNT9pin.oe = 'b'1;

o17.oe = 'b'0;
o18.oe = 'b'0;

/* Clocks */          
COUNT1pin.ck = !nH_TC;
V_TC.ck = CLK;
SPG_VCLR.ck = !nH_TC;
D1_VBLKG.ck = CLK & i8 & !D1_VBLKGq0;
nODD_FIELD.ck = CLK;
COUNT9pin.ck = !nH_TC;
COUNT8pin.ck = !nH_TC;
COUNT3pin.ck = !nH_TC;
COUNT0.ck = !nH_TC;
COUNT4.ck = !nH_TC;
COUNT5.ck = !nH_TC;
COUNT6.ck = !nH_TC;
COUNT7.ck = !nH_TC;
D1_VBLKG_RESET.ck = CLK & i8;
COUNT10.ck = !COUNT9;
COUNT2.ck = !nH_TC;

/* Asynchronous resets */
COUNT1pin.ar = V_TCq0;
D1_VBLKG.ar = D1_VBLKG_RESET;
COUNT9pin.ar = V_TCq0;
COUNT8pin.ar = V_TCq0;
COUNT3pin.ar = V_TCq0;
COUNT0.ar = V_TCq0;
COUNT4.ar = V_TCq0;
COUNT5.ar = V_TCq0;
COUNT6.ar = V_TCq0;
COUNT7.ar = V_TCq0;
COUNT10.ar = V_TCq0;
COUNT2.ar = V_TCq0;

/* Synchronous presets */
COUNT.sp = 'b'0;
COUNT1pin.sp = 'b'0;
COUNT3pin.sp = 'b'0;
COUNT8pin.sp = 'b'0;
COUNT9pin.sp = 'b'0;
D1_VBLKG.sp = 'b'0;
D1_VBLKG_RESET.sp = 'b'0;
SPG_VCLR.sp = 'b'0;
V_TC.sp = 'b'0;
nODD_FIELD.sp = 'b'0;